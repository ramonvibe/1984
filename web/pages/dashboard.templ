package pages

import (
	"fmt"
	"github.com/ramon/trackline/internal/activity"
	"github.com/ramon/trackline/internal/database"
	"github.com/ramon/trackline/internal/format"
	"github.com/ramon/trackline/internal/issue"
	"github.com/ramon/trackline/web/components"
	"github.com/ramon/trackline/web/layouts"
)

templ Dashboard(data DashboardData) {
	@layouts.Shell(data.Base, "Painel") {
		<div class="page-heading"><div><p class="eyebrow">VISÃO GERAL</p><h1>Vamos avançar.</h1><p class="muted">Um pouco de foco. Muito trabalho bem feito.</p></div><a class="button primary" href="/projects">Ver projetos <span aria-hidden="true">↗</span></a></div>
		<div class="stats-grid">
			@components.Stat("Tarefas abertas", fmt.Sprint(data.Stats.OpenIssues))
			@components.Stat("Tarefas concluídas", fmt.Sprint(data.Stats.CompletedIssues))
			@components.Stat("Erros abertos", fmt.Sprint(data.Stats.OpenBugs))
			@components.Stat("Tempo registrado", format.Duration(data.Stats.TrackedSeconds))
		</div>
		<div class="dashboard-grid">
			<section class="panel recent-panel">
				<div class="panel-heading"><h2>Tarefas recentes</h2><a href="/projects" class="subtle-link">Todos os projetos ↗</a></div>
				if len(data.Recent)==0 {
					@components.Empty("Um novo começo", "Crie um projeto e adicione sua primeira tarefa.")
				}
				for _, item := range data.Recent {
					<a class="issue-row" href={ templ.SafeURL("/issues/" + issue.Reference(item.ProjectKey, item.Number)) }>
						<span class="mono muted">{ issue.Reference(item.ProjectKey,item.Number) }</span><strong>{ item.Title }</strong>
						@components.Badge(item.Status)
						<span class="muted tiny">
							{ format.Relative(item.UpdatedAt.Time) }
						</span>
					</a>
				}
			</section>
			<section class="panel release-spotlight">
				<div class="panel-heading"><h2>Versão atual</h2><span class="live-dot"></span></div>
				if data.Release.ID==0 {
					@components.Empty("Qual é o próximo passo?", "Marque uma versão como ativa para acompanhar o progresso aqui.")
				} else {
					<p class="eyebrow">{ data.Release.ProjectKey }</p><a class="release-version" href={ templ.SafeURL(fmt.Sprintf("/releases/%d", data.Release.ID)) }>{ data.Release.Version }</a>
					<p>{ data.Release.Name }</p>
					@components.Progress(data.Release.DoneCount, data.Release.IssueCount)
					<div class="release-target"><span class="muted">Data prevista</span><strong>{ components.Date(data.Release.TargetDate) }</strong></div>
				}
			</section>
		</div>
		<div class="charts-grid">
			@components.Bars("Tempo por membro", data.Groups["member"])
			@components.Bars("Tempo por projeto", data.Groups["project"])
			@components.Bars("Tempo por tipo de tarefa", data.Groups["type"])
			@components.Bars("Tempo por versão", data.Groups["release"])
		</div>
		<section class="panel">
			<div class="panel-heading"><h2>Atividade recente</h2><span class="muted tiny">Em todo o espaço de trabalho</span></div>
			@RecentActivity(data.Activity)
		</section>
	}
}

templ RecentActivity(items []database.ListRecentActivityRow) {
	if len(items)==0 {
		<p class="muted chart-empty">A atividade da sua equipe aparecerá aqui.</p>
	}
	<ol class="timeline">
		for _, item := range items {
			<li>
				@components.UserAvatar(item.ActorID.Int64, components.Text(item.ActorName,"GitHub"), true)
				<div>
					<strong>{ components.Text(item.ActorName,"GitHub") }</strong> { activity.Human(item.Kind,item.Data) }
					if item.IssueID.Valid {
						<a class="subtle-link" href={ templ.SafeURL("/issues/" + issue.Reference(item.ProjectKey.String, item.IssueNumber.Int32)) }>{ issue.Reference(item.ProjectKey.String,item.IssueNumber.Int32) }</a>
					}
					<time class="muted tiny" datetime={ item.CreatedAt.Time.Format("2006-01-02T15:04:05Z07:00") }>{ format.Relative(item.CreatedAt.Time) }</time>
				</div>
			</li>
		}
	</ol>
}
