package pages

import (
	"fmt"
	"github.com/ramon/trackline/internal/format"
	"github.com/ramon/trackline/internal/issue"
	"github.com/ramon/trackline/internal/release"
	"github.com/ramon/trackline/web/components"
	"github.com/ramon/trackline/web/layouts"
	"net/url"
)

templ Projects(base layouts.Data) {
	@layouts.Shell(base, "Projects") {
		<div class="page-heading"><div><p class="eyebrow">MAKE ROOM FOR GOOD WORK</p><h1>Projects</h1><p class="muted">From the first idea to the next release.</p></div></div>
		<div class="project-grid">
			for _, project := range base.Projects {
				<a class="panel project-tile" href={ templ.SafeURL("/projects/" + project.Key) }>
					<div class="card-meta">
						<span class="project-icon large">{ layouts.Initial(project.Name) }</span>
						@components.Badge(project.Status)
					</div>
					<h2>{ project.Name }</h2>
					<p class="muted line-clamp">{ project.Description }</p>
					<div class="card-bottom">
						<span class="mono muted">{ project.Key }</span>
						<span>
							{ fmt.Sprintf("%d open · %d done",project.OpenIssues,project.DoneIssues) }
						</span>
					</div>
				</a>
			}
		</div>
		if len(base.Projects)==0 {
			@components.Empty("Your next project starts here", "Give your project a name and a short key, like PLAT.")
		}
		if base.User.Role=="admin" {
			<section class="panel form-panel">
				<div class="panel-heading"><h2>Create a project</h2></div>
				<form method="post" action="/projects" class="stack">
					@components.CSRF(base.CSRF)
					<div class="form-grid"><label>Project name<input name="name" required maxlength="120" placeholder="Platform"/></label><label>Key<input name="key" required pattern="[A-Za-z][A-Za-z0-9]{1,9}" maxlength="10" placeholder="PLAT"/><small class="muted">2–10 letters or numbers. Used in issue IDs.</small></label></div>
					<label>Description<textarea name="description" rows="3" maxlength="20000" placeholder="What are you building?"></textarea></label>
					<div><button class="button primary">Create project</button></div>
				</form>
			</section>
		}
	}
}

templ Project(data ProjectData) {
	@layouts.Shell(data.Base, data.Project.Name) {
		<div class="page-heading"><div><p class="eyebrow">{ data.Project.Key }</p><h1>{ data.Project.Name }</h1></div><a class="button primary" href={ templ.SafeURL("/projects/" + data.Project.Key + "/issues/new") }>+ New issue</a></div>
		@components.ProjectTabs(data.Project.Key, data.Tab)
		switch data.Tab {
			case "issues":
				@IssueList(data)
			case "board":
				@SprintToolbar(data)
				<p class="muted tiny">Drag cards between columns. Open any issue to change status with keyboard controls. Up to 500 recently updated issues.</p>
				<div class="board">
					for _, status := range issue.Statuses[:5] {
						<section class="board-column" data-status={ status }>
							<h2><span class={ "status-dot dot-" + status }></span>{ components.Name(status) } <small class="column-count">{ fmt.Sprint(boardCount(data,status)) }</small></h2>
							<div class="board-cards">
								for _, item := range data.Board {
									if item.Status==status {
										@components.IssueCard(item)
									}
								}
							</div>
						</section>
					}
				</div>
			case "calendar":
				@CalendarView(data.Calendar)
			case "releases":
				@ReleaseList(data)
			case "time":
				@Reports(data.Reports, data.Estimates, data.DateFrom, data.DateTo)
			case "settings":
				@ProjectSettings(data)
			default:
				<div class="dashboard-grid">
					<section class="panel">
						<div class="panel-heading">
							<h2>About this project</h2>
							@components.Badge(data.Project.Status)
						</div>
						<div class="markdown">
							@format.Markdown(data.Project.Description)
						</div>
						<div class="panel-heading"><h3>Project members</h3></div>
						<div class="member-list">
							for _, member := range data.Members {
								<span class="member-chip"><span class="avatar small">{ layouts.Initial(member.Name) }</span>{ member.Name }</span>
							}
						</div>
						if len(data.Members)==0 {
							<p class="muted">No members added yet.</p>
						}
					</section>
					<section class="panel"><div class="panel-heading"><h2>Keep work moving</h2></div><div class="quick-links"><a href={ templ.SafeURL("/projects/" + data.Project.Key + "/issues") }>Review issues <span>↗</span></a><a href={ templ.SafeURL("/projects/" + data.Project.Key + "/board") }>Open board <span>↗</span></a><a href={ templ.SafeURL("/projects/" + data.Project.Key + "/releases") }>Plan a release <span>↗</span></a><a href={ templ.SafeURL("/projects/" + data.Project.Key + "/time") }>Check time reports <span>↗</span></a></div></section>
				</div>
				@IssueList(data)
		}
	}
}

func boardCount(data ProjectData, status string) int {
	n := 0
	for _, item := range data.Board {
		if item.Status == status {
			n++
		}
	}
	return n
}

templ IssueList(data ProjectData) {
	<section class="panel list-panel">
		<div class="panel-heading">
			<h2>Issues</h2>
			<form method="get" class="inline-form" action={ "/projects/" + data.Project.Key + "/issues" }>
				<label class="sr-only" for="filter-status">Status</label>
				<select id="filter-status" name="status">
					<option value="">All statuses</option>
					for _, status := range issue.Statuses {
						<option selected?={ data.Status==status } value={ status }>{ components.Name(status) }</option>
					}
				</select><label class="sr-only" for="filter-type">Type</label>
				<select id="filter-type" name="type">
					<option value="">All types</option>
					for _, kind := range issue.Types {
						<option selected?={ data.Type==kind } value={ kind }>{ components.Name(kind) }</option>
					}
				</select><button class="button small-button">Filter</button>
			</form>
		</div>
		if len(data.Issues)==0 {
			@components.Empty("No issues here", "Create an issue or adjust your filters.")
		} else {
			<div class="table-scroll">
				<table class="issue-table">
					<thead><tr><th>Issue</th><th>Title</th><th>Status</th><th>Priority</th><th>Assignee</th></tr></thead>
					<tbody>
						for _, item := range data.Issues {
							<tr>
								<td><a class="mono muted" href={ templ.SafeURL("/issues/" + issue.Reference(item.ProjectKey, item.Number)) }>{ issue.Reference(item.ProjectKey,item.Number) }</a></td>
								<td>
									<a class="issue-title" href={ templ.SafeURL("/issues/" + issue.Reference(item.ProjectKey, item.Number)) }>{ item.Title }</a>
									<div class="labels">
										<span class="muted tiny">{ components.Name(item.Type) }</span>
										for _, label := range components.Labels(item.LabelNames) {
											<span class="label">{ label }</span>
										}
									</div>
								</td>
								<td>
									@components.Badge(item.Status)
								</td>
								<td>
									@components.Priority(item.Priority)
								</td>
								<td>
									{ components.Text(item.AssigneeName,"Unassigned") }
								</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
		}
		<div class="pagination">
			<span class="muted tiny">Page { fmt.Sprint(max(data.Page,1)) } · 50 issues per page</span>
			<div>
				if data.Page>1 {
					<a class="button small-button" href={ templ.SafeURL(issuePageURL(data, data.Page-1)) }>Previous</a>
				}
				if data.HasNext {
					<a class="button small-button" href={ templ.SafeURL(issuePageURL(data, data.Page+1)) }>Next</a>
				}
			</div>
		</div>
	</section>
}

func issuePageURL(data ProjectData, page int) string {
	return "/projects/" + data.Project.Key + "/issues?" + url.Values{"page": {fmt.Sprint(page)}, "status": {data.Status}, "type": {data.Type}}.Encode()
}

templ ReleaseList(data ProjectData) {
	<div class="project-grid">
		for _, item := range data.Releases {
			<a class="panel release-tile" href={ templ.SafeURL(fmt.Sprintf("/releases/%d", item.ID)) }>
				<div class="card-meta">
					<h2>{ item.Version }</h2>
					@components.Badge(item.Status)
				</div>
				<p>{ item.Name }</p>
				@components.Progress(item.DoneCount, item.IssueCount)
				<div class="card-bottom">
					<span class="muted">
						{ components.Date(item.TargetDate) }
					</span><span>{ format.Duration(item.SpentSeconds) } tracked</span>
				</div>
			</a>
		}
	</div>
	if len(data.Releases)==0 {
		@components.Empty("Ship with a little more clarity", "Group your issues into a release and track the finish line.")
	}
	<details class="panel form-panel">
		<summary>Create a release</summary>
		<form method="post" action={ "/projects/" + data.Project.Key + "/releases" } class="stack">
			@components.CSRF(data.Base.CSRF)
			<div class="form-grid">
				<label>Version<input name="version" required maxlength="80" placeholder="v1.0.0"/></label><label>Name<input name="name" maxlength="120" placeholder="A meaningful milestone"/></label><label>Target date<input type="date" name="target_date"/></label>
				<label>
					Status 
					@components.Select("status", "planning", release.Statuses)
				</label>
			</div><label>Description<textarea name="description" maxlength="20000" rows="3"></textarea></label>
			<div><button class="button primary">Create release</button></div>
		</form>
	</details>
}

templ ProjectSettings(data ProjectData) {
	if data.Base.User.Role!="admin" {
		@components.Empty("Admin settings", "Ask a workspace admin to change project settings.")
	} else {
		<section class="panel form-panel">
			<div class="panel-heading"><h2>Project details</h2><span class="mono muted">{ data.Project.Key }</span></div>
			<form method="post" action={ "/projects/" + data.Project.Key + "/settings" } class="stack">
				@components.CSRF(data.Base.CSRF)
				<label>Name<input name="name" value={ data.Project.Name } required maxlength="120"/></label><label>Description<textarea name="description" maxlength="20000" rows="3">{ data.Project.Description }</textarea></label>
				<label>
					Status 
					@components.Select("status", data.Project.Status, []string{"active", "archived"})
				</label>
				<div><button class="button primary">Save project</button></div>
			</form>
		</section>
		<section class="panel form-panel">
			<div class="panel-heading"><h2>Project members</h2></div>
			for _, member := range data.Members {
				<div class="settings-row">
					<span>{ member.Name } <small class="muted">{ member.Email }</small></span>
					<form method="post" action={ "/projects/" + data.Project.Key + "/members" }>
						@components.CSRF(data.Base.CSRF)
						<input
							name="user_id"
							type="hidden"
							value={ fmt.Sprint(member.ID) }
						/><input name="remove" type="hidden" value="true"/><button class="button small-button">Remove</button>
					</form>
				</div>
			}
			<form method="post" action={ "/projects/" + data.Project.Key + "/members" } class="inline-form">
				@components.CSRF(data.Base.CSRF)
				<label>
					Add member
					<select name="user_id">
						for _, user := range data.Users {
							<option value={ fmt.Sprint(user.ID) }>{ user.Name }</option>
						}
					</select>
				</label><button class="button">Add member</button>
			</form>
			<p class="muted tiny">Membership helps organize your team. All workspace members can see and work on every project.</p>
		</section>
		<section class="panel form-panel">
			<div class="panel-heading">
				<h2>GitHub</h2>
				<span class={ templ.KV("connected", data.Repository.ID != 0) }>
					if data.Repository.ID!=0 {
						Connected 
					} else {
						Not connected 
					}
				</span>
			</div>
			if data.Repository.ID!=0 {
				<p class="mono">{ data.Repository.FullName }</p>
			}
			if !data.GitHubEnabled {
				<p class="muted">GitHub is optional. Your installation admin can configure a GitHub App to link development and publish releases.</p>
			} else {
				if data.GitHubSlug!="" {
					<p><a class="button" href={ templ.SafeURL("https://github.com/apps/" + data.GitHubSlug + "/installations/new") } target="_blank" rel="noopener noreferrer">Install GitHub App ↗</a></p>
				}
				<form method="post" action={ "/projects/" + data.Project.Key + "/github" } class="stack">
					@components.CSRF(data.Base.CSRF)
					<label>Installation ID<input name="installation_id" type="number" min="1" required placeholder="From your GitHub installation URL"/></label><label>Repository<input name="repository" required placeholder="owner/repository" maxlength="200"/></label>
					<div><button class="button primary">Connect repository</button></div>
				</form>
				<p class="muted tiny">The App must have access to this repository. Repository access is verified before connecting.</p>
			}
		</section>
	}
}
