package pages

import (
	"fmt"
	"github.com/ramon/trackline/internal/calendar"
	"github.com/ramon/trackline/internal/database"
	"github.com/ramon/trackline/internal/format"
	"github.com/ramon/trackline/internal/issue"
	"github.com/ramon/trackline/web/components"
	"github.com/ramon/trackline/web/layouts"
)

templ Calendar(base layouts.Data, month calendar.Month) {
	@layouts.Shell(base, "Calendário") {
		<div class="page-heading"><div><p class="eyebrow">VISÃO GERAL</p><h1>Calendário</h1><p class="muted">Datas de tarefas e marcos de versões no mesmo lugar.</p></div></div>
		@CalendarView(month)
	}
}

templ CalendarView(month calendar.Month) {
	<section class="panel calendar-panel">
		<div class="panel-heading"><h2>{ month.Title }</h2><div class="inline-form"><a class="button small-button" href={ templ.SafeURL("?month=" + month.Previous) } aria-label="Mês anterior">←</a><a class="button small-button" href="?">Hoje</a><a class="button small-button" href={ templ.SafeURL("?month=" + month.Next) } aria-label="Próximo mês">→</a></div></div>
		<div class="calendar-scroll">
			<div class="calendar">
				for _, day := range []string{
"Seg","Ter","Qua","Qui","Sex","Sáb","Dom"} {
					<div class="weekday">{ day }</div>
				}
				for _, day := range month.Days {
					<div class={ "calendar-day",templ.KV("outside",!day.Current),templ.KV("today",day.Today) }>
						<time datetime={ day.Date.Format("2006-01-02") }>{ fmt.Sprint(day.Date.Day()) }</time>
						for _, event := range day.Events {
							<a class={ "calendar-event event-" + event.Kind } href={ templ.SafeURL(event.URL) } title={ calendar.KindName(event.Kind) + ": " + event.Title }><small>{ calendar.KindName(event.Kind) }</small>{ event.Title }</a>
						}
					</div>
				}
			</div>
		</div>
	</section>
}

templ TimeReports(base layouts.Data, groups map[string][]database.ReportGroupsRow, from, to string) {
	@layouts.Shell(base, "Relatórios de tempo") {
		<div class="page-heading"><div><p class="eyebrow">PARA ONDE VAI O TEMPO</p><h1>Relatórios de tempo</h1><p class="muted">Entenda o esforço por trás do trabalho da equipe.</p></div></div>
		@Reports(groups, nil, from, to)
	}
}

templ Reports(groups map[string][]database.ReportGroupsRow, estimates []database.ProjectTimeReportRow, from, to string) {
	<form method="get" class="panel report-filter inline-form"><label>De (UTC)<input type="date" name="from" value={ from }/></label><label>Até (UTC)<input type="date" name="to" value={ to }/></label><button class="button primary">Aplicar período</button><a class="button" href="?">Todo o período</a></form>
	<p class="muted tiny">Os registros são contados pela data inicial. Cronômetros ativos estão incluídos. Cada relatório mostra até 200 grupos.</p>
	<div class="charts-grid">
		@components.Bars("Tempo por membro", groups["member"])
		@components.Bars("Tempo por projeto", groups["project"])
		@components.Bars("Tempo por tipo de tarefa", groups["type"])
		@components.Bars("Tempo por versão", groups["release"])
	</div>
	@components.Bars("Tempo por tarefa", groups["issue"])
	if len(estimates)>0 {
		<section class="panel">
			<div class="panel-heading"><h2>Estimativa e tempo registrado</h2></div>
			<div class="table-scroll">
				<table>
					<thead><tr><th>Tarefa</th><th>Estimado</th><th>Registrado</th><th>Diferença</th></tr></thead>
					<tbody>
						for _, row := range estimates {
							<tr><td><a href={ templ.SafeURL("/issues/" + issue.Reference(row.ProjectKey, row.Number)) }>{ issue.Reference(row.ProjectKey,row.Number) } · { row.Title }</a></td><td>{ format.Minutes(row.EstimatedMinutes) }</td><td>{ format.Duration(row.SpentSeconds) }</td><td>{ difference(row.SpentSeconds-int64(row.EstimatedMinutes)*60) }</td></tr>
						}
					</tbody>
				</table>
			</div>
		</section>
	}
}

func difference(value int64) string {
	if value < 0 {
		return "-" + format.Duration(-value)
	}
	return "+" + format.Duration(value)
}

templ Settings(data SettingsData) {
	@layouts.Shell(data.Base, "Configurações") {
		<div class="page-heading"><div><p class="eyebrow">{ data.Base.User.WorkspaceName }</p><h1>Configurações</h1><p class="muted">Boas opções padrão e controles úteis.</p></div></div>
		<section class="panel form-panel"><div class="panel-heading"><h2>Meu perfil</h2></div><form method="post" action="/settings/profile" enctype="multipart/form-data" class="stack">@components.CSRF(data.Base.CSRF)<label>Seu nome<input name="name" required maxlength="120" value={ data.Base.User.Name }/></label><label>Foto de perfil<input type="file" name="avatar" accept="image/png,image/jpeg,image/webp,image/gif"/><small>PNG, JPEG, WebP ou GIF de até 5 MB.</small></label>
			if data.Base.User.HasAvatar {
				<div class="branding-preview"><img src="/profile/avatar" alt="Foto atual"/><label class="checkbox-label"><input type="checkbox" name="remove_avatar" value="1"/>Remover foto atual</label></div>
			}
			<div><button class="button primary">Salvar perfil</button></div></form></section>
		if data.Base.User.Role=="admin" {
			<section class="panel form-panel">
				<div class="panel-heading"><h2>Identidade do sistema</h2></div>
				<form method="post" action="/settings/branding" enctype="multipart/form-data" class="stack">
					@components.CSRF(data.Base.CSRF)
					<label>Nome do sistema<input name="app_name" required maxlength="60" value={ data.Base.AppName }/></label>
					<label>Logo<input type="file" name="logo" accept="image/png,image/jpeg,image/webp,image/gif"/><small>PNG, JPEG, WebP ou GIF de até 5 MB.</small></label>
					if data.Base.HasLogo {
						<div class="branding-preview"><img src="/brand/logo" alt="Logo atual"/><label class="checkbox-label"><input type="checkbox" name="remove_logo" value="1"/>Remover logo atual</label></div>
					}
					<div><button class="button primary">Salvar identidade</button></div>
				</form>
			</section>
			<section class="panel form-panel">
				<div class="panel-heading"><h2>Comportamento das sprints</h2></div>
				<form method="post" action="/settings/sprint-options" class="stack">
					@components.CSRF(data.Base.CSRF)
					<label class="checkbox-label"><input type="checkbox" name="sprints_are_releases" value="1" checked?={ data.Base.User.SprintsAreReleases }/> Sprints são versões</label>
					<p class="muted tiny">Ao criar uma sprint, o 1984 cria automaticamente uma versão com o mesmo nome no projeto.</p>
					<div><button class="button">Salvar opção</button></div>
				</form>
			</section>
		}
		<section class="panel">
			<div class="panel-heading"><h2>Pessoas</h2><span class="muted tiny">{ fmt.Sprint(len(data.Users)) } membros</span></div>
			<div class="table-scroll">
				<table>
					<thead><tr><th>Nome</th><th>Email</th><th>Função</th></tr></thead>
					<tbody>
						for _, user := range data.Users {
							<tr><td>{ user.Name }</td><td>{ user.Email }</td><td>{ layouts.Role(user.Role) }
								if data.Base.User.Role=="admin" && user.Role!="admin" {
									<form method="post" action={ fmt.Sprintf("/settings/users/%d/role",user.ID) } class="inline-form">@components.CSRF(data.Base.CSRF)<button class="button small-button">Tornar administrador</button></form>
								}
							</td></tr>
						}
					</tbody>
				</table>
			</div>
		</section>
		if data.Base.User.Role=="admin" {
			<section class="panel form-panel">
				<div class="panel-heading"><h2>Convite para o workspace</h2></div>
				<p class="muted">Quem usar o link entra como membro. O convite expira em 7 dias.</p>
				<form method="post" action="/settings/invites">@components.CSRF(data.Base.CSRF)<button class="button primary">Gerar link de convite</button></form>
				if data.InviteURL!="" {
					<label>Link gerado<input readonly value={ data.InviteURL } onclick="this.select()"/></label>
				}
			</section>
			<details class="panel form-panel">
				<summary>Adicionar usuário</summary>
				<form method="post" action="/settings/users" class="stack">
					@components.CSRF(data.Base.CSRF)
					<div class="form-grid"><label>Nome<input name="name" required maxlength="120" autocomplete="off"/></label><label>Email<input type="email" name="email" required maxlength="254" autocomplete="off"/></label><label>Senha<input type="password" name="password" required minlength="12" maxlength="256" autocomplete="new-password"/></label><label>Função<select name="role"><option value="member">Membro</option><option value="admin">Administrador</option></select></label></div>
					<p class="muted tiny">Compartilhe a senha em particular com o novo usuário.</p>
					<div><button class="button primary">Adicionar usuário</button></div>
				</form>
			</details>
		}
		<section class="panel form-panel">
			<div class="panel-heading"><h2>Etiquetas</h2></div>
			<div class="labels label-picker">
				for _, label := range data.Labels {
					<span class="label">{ label.Name }</span>
				}
			</div>
			<form method="post" action="/settings/labels" class="inline-form">
				@components.CSRF(data.Base.CSRF)
				<label>Nova etiqueta<input name="name" required maxlength="40" placeholder="ex.: acessibilidade"/></label><label>Cor<input type="color" name="color" value="#64748b"/></label><button class="button">Criar etiqueta</button>
			</form>
		</section>
		<section class="panel form-panel">
			<div class="panel-heading"><h2>GitHub App</h2></div>
			if data.GitHubEnabled {
				<p class="connected">Configurado. Conecte um repositório nas configurações de cada projeto.</p>
			} else {
				<p class="muted">Não configurado. O restante do espaço de trabalho funciona normalmente.</p>
			}
		</section>
	}
}

templ Search(data SearchData) {
	@layouts.Shell(data.Base, "Busca") {
		<div class="page-heading"><div><h1>Buscar</h1><p class="muted">Encontre uma tarefa, projeto ou versão.</p></div></div>
		<form method="get" action="/search" class="search-form"><input name="q" value={ data.Query } type="search" autofocus maxlength="100" placeholder="Digite um código, título, projeto ou versão…" aria-label="Buscar"/><button class="button primary">Buscar</button></form>
		<section class="panel">
			<div class="panel-heading"><h2>Resultados</h2><span class="muted">{ data.Query }</span></div>
			if data.Query=="" {
				@components.Empty("Encontre o que procura", "Digite um termo de busca acima.")
			} else if len(data.Issues)==0 && len(data.Others)==0 {
				@components.Empty("Nenhum resultado", "Tente outro título, projeto, versão ou código de tarefa.")
			}
			for _, item := range data.Issues {
				<a class="issue-row" href={ templ.SafeURL("/issues/" + issue.Reference(item.ProjectKey, item.Number)) }>
					<span class="mono muted">{ issue.Reference(item.ProjectKey,item.Number) }</span><strong>{ item.Title }</strong>
					@components.Badge(item.Status)
				</a>
			}
			for _, item := range data.Others {
				<a class="issue-row" href={ templ.SafeURL(fmt.Sprint(item.Url)) }><span class="muted">{ item.Kind }</span><strong>{ item.Title }</strong></a>
			}
		</section>
	}
}
