package layouts

import (
	"fmt"
	"github.com/ramon/trackline/internal/auth"
	"github.com/ramon/trackline/internal/database"
	"github.com/ramon/trackline/internal/issue"
)

type Data struct {
	User     auth.User
	Projects []database.ListProjectsRow
	CSRF     string
	Path     string
	Timer    database.GetActiveTimerRow
}

templ Document(title, csrf string) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<meta name="csrf-token" content={ csrf }/>
			<meta name="htmx-config" content='{"allowEval":false,"includeIndicatorStyles":false,"selfRequestsOnly":true}'/>
			<title>{ title } · Trackline</title>
			<link rel="stylesheet" href="/static/app.css"/>
			<script src="/static/vendor/htmx.min.js" defer></script>
			<script src="/static/app.js" defer></script>
		</head>
		<body>
			<a class="skip-link" href="#main">Skip to content</a>
			{ children... }
			<div id="notice" class="notice" role="alert" hidden></div>
		</body>
	</html>
}

templ Shell(data Data, title string) {
	@Document(title, data.CSRF) {
		<div class="app-shell">
			<aside class="sidebar" aria-label="Workspace navigation">
				<a class="brand" href="/"><span class="brand-mark">t</span>Trackline</a>
				<div class="workspace-name"><span class="workspace-icon">{ Initial(data.User.WorkspaceName) }</span><span>{ data.User.WorkspaceName }</span><small>Workspace</small></div>
				<nav>
					<a class={ templ.KV("selected", data.Path == "/") } href="/"><span aria-hidden="true">◫</span>Dashboard</a>
					<a class={ templ.KV("selected", data.Path == "/projects") } href="/projects"><span aria-hidden="true">▤</span>Projects</a>
					<a class={ templ.KV("selected", data.Path == "/calendar") } href="/calendar"><span aria-hidden="true">▦</span>Calendar</a>
					<a class={ templ.KV("selected", data.Path == "/time") } href="/time"><span aria-hidden="true">◷</span>Time reports</a>
				</nav>
				<div class="nav-heading">Your projects <a href="/projects" aria-label="Create a project">+</a></div>
				<nav class="project-nav">
					for _, project := range data.Projects {
						<a href={ templ.SafeURL("/projects/" + project.Key) }><span class="project-icon">{ Initial(project.Name) }</span><span>{ project.Name }</span><small>{ fmt.Sprint(project.OpenIssues) }</small></a>
					}
					if len(data.Projects)==0 {
						<p class="muted tiny">Your projects will appear here.</p>
					}
				</nav>
				<div class="sidebar-bottom">
					if data.Timer.ID!=0 {
						<a class="running-timer" href={ templ.SafeURL("/issues/" + issue.Reference(data.Timer.ProjectKey, data.Timer.IssueNumber)) }><span class="live-dot"></span>Timer running <strong>{ issue.Reference(data.Timer.ProjectKey,data.Timer.IssueNumber) }</strong></a>
					}
					<a class="settings-link" href="/settings">Workspace settings</a>
					<div class="user-card"><span class="avatar">{ Initial(data.User.Name) }</span><div><strong>{ data.User.Name }</strong><small>{ data.User.Role }</small></div><form method="post" action="/logout"><input type="hidden" name="csrf" value={ data.CSRF }/><button class="icon-button" title="Sign out" aria-label="Sign out">↗</button></form></div>
				</div>
			</aside>
			<div class="app-content">
				<header class="topbar"><span class="breadcrumb">{ data.User.WorkspaceName } <span>/</span> { title }</span><form role="search" action="/search" method="get"><label class="search-box"><span aria-hidden="true">⌕</span><input name="q" type="search" placeholder="Search issues, projects, releases…" aria-label="Search issues, projects and releases" maxlength="100"/><kbd>/</kbd></label></form></header>
				<main id="main" class="main">{ children... }
</main>
				<footer class="app-footer">Everything a small software team needs. Nothing it doesn't.</footer>
			</div>
		</div>
	}
}

func Initial(value string) string {
	for _, letter := range value {
		return string(letter)
	}
	return "T"
}
